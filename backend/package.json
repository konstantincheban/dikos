{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"libs/**/*.ts\"",
    "start": "cross-env NODE_ENV=production nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/src/main",
    "lint": "eslint --no-error-on-unmatched-pattern \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint --no-error-on-unmatched-pattern \"{src,apps,libs,test}/**/*.ts\" --fix",
    "type-check": "tsc --noEmit",
    "docker:build": "docker build --target production -t dikos-api:local .",
    "deploy:staging": "gcloud builds submit --tag europe-west1-docker.pkg.dev/$GCP_PROJECT_ID/dikos/dikos-api:staging . && gcloud run deploy dikos-api --image europe-west1-docker.pkg.dev/$GCP_PROJECT_ID/dikos/dikos-api:staging --region europe-west1 --platform managed --allow-unauthenticated",
    "deploy:prod": "gcloud builds submit --tag europe-west1-docker.pkg.dev/$GCP_PROJECT_ID/dikos/dikos-api:production . && gcloud run deploy dikos-api --image europe-west1-docker.pkg.dev/$GCP_PROJECT_ID/dikos/dikos-api:production --region europe-west1 --platform managed --allow-unauthenticated",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --verbose"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.0.4",
    "@nestjs/mongoose": "^10.0.2",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "10.4.22",
    "@nestjs/websockets": "^10.3.0",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "chokidar": "^3.5.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14",
    "cross-env": "^7.0.3",
    "csurf": "^1.11.0",
    "helmet": "^5.0.2",
    "moment": "^2.29.3",
    "mongoose": "^6.3.1",
    "nestjs-pino": "^3.5.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.2.0",
    "socket.io": "4.8.3",
    "ws": "^8.15.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.30.1",
    "@nestjs/cli": "^10.2.1",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.13",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.7",
    "@types/node": "^24.0.13",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^2.0.11",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.0",
    "globals": "^16.3.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "^29.4.1",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^3.10.1",
    "typescript": "~5.8.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@accounts/(.*)$": "<rootDir>/src/accounts/$1",
      "^@analytics/(.*)$": "<rootDir>/src/analytics/$1",
      "^@auth/(.*)$": "<rootDir>/src/auth/$1",
      "^@budget/(.*)$": "<rootDir>/src/budget/$1",
      "^@metro/(.*)$": "<rootDir>/src/metro/$1",
      "^@statistics/(.*)$": "<rootDir>/src/statistics/$1",
      "^@transactions/(.*)$": "<rootDir>/src/transactions/$1",
      "^@users/(.*)$": "<rootDir>/src/users/$1",
      "^@utils/(.*)$": "<rootDir>/src/utils/$1",
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src/",
      "<rootDir>/libs/"
    ]
  }
}
